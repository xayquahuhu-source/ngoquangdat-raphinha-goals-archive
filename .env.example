# Cấu hình Google Gemini AI cho Raphinha AI Pro
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Thứ tự ưu tiên mô hình AI: 4.0 Argon (ưu tiên cao nhất) -> 3.8 Flash -> 3.5 Lite
# Hệ thống sẽ tự động thử lần lượt: nếu được thì lấy Argon, không được lấy 3.8 Flash, rồi mới lấy 3.5 Lite
GEMINI_MODEL=gemini-4.0-argon

# Cổng khởi chạy Server (mặc định 3000)
PORT=3000
